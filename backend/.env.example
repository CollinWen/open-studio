# Copy this file to .env and fill in the values.

# Your private admin password. Make it long and random.
OWNER_TOKEN=

# Agents allowed to read the studio and add entries (see skills/open-studio/).
# Comma-separated name=token pairs. Each agent adds only to boards that list its name,
# and its entries arrive unlisted, for you to publish.
# AGENT_TOKENS=scout=long-random-token,archivist=another-long-random-token
# AGENT_WRITES_PER_HOUR=60

# Runs: one task for one agent, with a short-lived token (see features/runs/).
# Tokens are signed with RUN_TOKEN_SECRET; leave it empty to use one made from OWNER_TOKEN
# (then changing the password ends every run). Long and random, like OWNER_TOKEN.
# RUN_TOKEN_SECRET=
# RUN_HOURS=4
# RUN_HOURS_MAX=24
# The API's public address, written into each run's kit (empty: the address it's called on).
# PUBLIC_API_URL=https://api.yourdomain.com

# OpenRouter key (the same kind of key macro-research uses).
OPENROUTER_API_KEY=

# Optional: which models to use on OpenRouter.
# TAG_MODEL=z-ai/glm-5.3-flash
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: where the database and uploaded images are kept.
# DATA_DIR=./data

# Which website may call the API from a browser (your Firebase-hosted site in production).
# FRONTEND_ORIGIN=http://localhost:5173

# Cloudflare R2 media storage. Leave these empty to keep uploads on disk (local development).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# MEDIA_PUBLIC_URL=https://media.yourdomain.com

# The largest write-up (an entry's HTML, embedded pictures included) the studio stores, in bytes.
# WRITEUP_MAX_BYTES=5000000
# How much of an entry's write-up text (the start of it) goes into its tags and embedding.
# WRITEUP_TEXT_FOR_MEANING=6000
