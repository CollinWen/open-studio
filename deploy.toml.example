# Every deploy setting in one place. Copy to deploy.toml (never committed) and fill in.
# `python deploy.py` reads it and passes each value to Fly.io and Firebase.
# Local development still uses backend/.env.

[site]
domain = "yourdomain.com"        # site at yourdomain.com, API at api., media at media.

[fly]
app = "open-studio-api"          # the name `fly launch` gave the backend

[firebase]
project = "open-studio-12345"    # Firebase project ID (console → Project settings)

[r2]
account_id = ""                  # Cloudflare dashboard → R2 → Account ID
access_key_id = ""               # from the R2 API token
secret_access_key = ""
bucket = "open-studio-media"

[agents]
# Where agents' skills are read from (AGENT_RESOURCES): GitHub folders at a branch, comma separated.
# Left out, a deploy from GitHub Actions uses this repo's skills/ at the commit it deploys.
# resources = "github:CollinWen/open-studio@main/skills"

[composio]
# Optional: toolkits (outside services' tools agents use through the studio). Leave empty for none.
api_key = ""                     # Composio project → Settings → API key
# user_id = "open-studio"        # the Composio user your connected accounts belong to

[secrets]
owner_token = ""                 # your admin password; long and random
openrouter_api_key = ""
# run_token_secret = ""          # optional: signs agents' run tokens (default: made from owner_token)
